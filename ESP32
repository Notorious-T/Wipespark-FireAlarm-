#define WIFI_SSID "Peppyeta7"
#define WIFI_PASSWORD "Peppyeta0"
#define API_KEY "AIzaSyCoT4mvSMehM5utSyir53agSswKzwoL_xQ"
#define DATABASE_URL "https://wipespark-54bd6-default-rtdb.asia-southeast1.firebasedatabase.app/" 

FirebaseData fbdo;
FirebaseAuth auth;
FirebaseConfig config;

const int relay1 = 26;
const int relay2 = 27;
const int dhtPin = 4;
const int mqPin = 34;

#define DHTTYPE DHT11
DHT dht(dhtPin, DHTTYPE);

const int threshold = 2500;
int alertcount = 0;
unsigned long lastReconnect = 0;
unsigned long sendDataPrevMillis = 0;
const long sendInterval = 15000; 


void connectWiFi() {
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected");
}

void sendDataToFirebase(int gas, float temp, float hum, bool alert) {
  if (Firebase.ready()) {
    FirebaseJson json;
    

    json.set("gas", gas);
    

    json.set("temp", isnan(temp) ? 0 : temp); 
    json.set("humidity", isnan(hum) ? 0 : hum);
    
    json.set("status", alert ? "ALERT" : "NORMAL");

   
    if (!Firebase.RTDB.setJSON(&fbdo, "/devices/device1/sensor", &json)) {
      Serial.println("Firebase Error: " + fbdo.errorReason());
    }
  }
}

void reconnectSystem() {
  if (WiFi.status() != WL_CONNECTED && millis() - lastReconnect > 5000) {
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    lastReconnect = millis();
  }
  if (WiFi.status() == WL_CONNECTED && !Firebase.ready()) {
    Firebase.begin(&config, &auth);
  }
}


void setup() {
  Serial.begin(9600);
  pinMode(relay1, OUTPUT);
  pinMode(relay2, OUTPUT);
  digitalWrite(relay1, HIGH);
  digitalWrite(relay2, HIGH);

  connectWiFi();

  config.api_key = API_KEY;
  config.database_url = DATABASE_URL;
  config.token_status_callback = tokenStatusCallback; 
  auth.user.email = "narainrit1909@gmail.com";
  auth.user.password = "123456";

  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);
  dht.begin();
}

void loop() {
  reconnectSystem();

  int GasLv = analogRead(mqPin);
  float humidity = dht.readHumidity();
  float temperature = dht.readTemperature();

  Serial.print("Gas: "); Serial.println(GasLv);
  Serial.print("Temperature: "); Serial.println(temperature);
  Serial.print("Humidity: "); Serial.println(humidity);

  if (GasLv > threshold || temperature > 50 || (humidity > 0 && humidity < 20)) {
    alertcount++;
  } else {
    alertcount = 0;
  }
  bool isAlert = alertcount > 3;

  if (isAlert) {
    Serial.println("STATUS: ALERT");
    digitalWrite(relay1, LOW); 
    digitalWrite(relay2, LOW);
  } else {
    Serial.println("STATUS: NORMAL");
    digitalWrite(relay1, HIGH);
    digitalWrite(relay2, HIGH);
  }

  if (Firebase.ready() && (millis() - sendDataPrevMillis > sendInterval || isAlert)) {
    sendDataPrevMillis = millis(); 
    sendDataToFirebase(GasLv, temperature, humidity, isAlert);
    
    static bool nameSent = false;
    if (!nameSent) {
      Firebase.RTDB.setString(&fbdo, "/devices/device1/name", "WipeSpark Unit 01");
      nameSent = true;
    }
  }
  Serial.println("----------------------------");
  delay(2000);
}
